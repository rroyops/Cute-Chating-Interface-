rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Princess State Collection
    match /princess/{stateId} {
      allow read, write: if true;
    }

    // Cats Collection
    match /cats/{catId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
